Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Existing files and directories ko direct serve karein
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Baaki requests Laravel ko bhejein
    RewriteRule ^ index.php [L]
</IfModule>